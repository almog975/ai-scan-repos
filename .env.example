# Copy to .env (never commit .env). In Kubernetes these become Secrets created from the CLI.

# --- Local / Compose ---
# Port of the UI on the host (http://localhost:$AISCAN_HTTP_PORT; also the OAuth callback host).
AISCAN_HTTP_PORT=8080
# Scratch dir for clones inside review-api (local launcher). Compose mounts the `work` volume there.
WORK_DIR=/work
INTERNAL_API_TOKEN=change-me-long-random
# openssl rand -hex 32   (AES-256-GCM key, 32 bytes)
AI_KEYS_ENCRYPTION_KEY=
POSTGRES_PASSWORD=aiscan-dev
# AI: openai_compatible (LM Studio/Ollama/vLLM) | openai | anthropic | gemini | grok | none
AI_PROVIDER=none
AI_MODEL=local-model
AI_BASE_URL=http://host.docker.internal:1234/v1
AI_API_KEY=

# --- Gateway (Phase 2) ---
# GitHub OAuth App: callback URL = http://localhost:8080/auth/github/callback (compose)
#   k3d (make local-k8s): https://ai-scan.localhost/auth/github/callback (separate OAuth App, docs/local-k3d.md)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Optional comma-separated allowlist / admins (GitHub logins)
ALLOWED_GITHUB_LOGINS=
ADMIN_GITHUB_LOGINS=
WEBHOOK_AUTO_REVIEW=false
