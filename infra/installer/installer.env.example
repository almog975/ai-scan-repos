# AI Scan Repos installer config (copy to installer.env, keep it OUT of git: it is .gitignored).
# Placeholders only. Values in the environment override this file; flags override both.
OVERLAY=k3s                 # k3s | eks | local
MODE=gitops                 # gitops (Argo CD app-of-apps, k3s) | direct (kubectl apply -k)
IMAGE_TAG=GIT_SHA_PLACEHOLDER
NODE_NAME=REPLACE_ME        # k3s: node that holds the reports hostPath PV
# EFS_FILESYSTEM_ID=fs-REPLACE_ME   # eks

# --- registry: local (in-cluster registry:2 + htpasswd) -------------------------------------------------------
REGISTRY_TYPE=local
# REGISTRY_HOST=registry.ai-scan.127.0.0.1.nip.io
REGISTRY_PUSH_USER=REPLACE_ME
REGISTRY_PUSH_PASSWORD=REPLACE_ME
REGISTRY_PULL_USER=REPLACE_ME
REGISTRY_PULL_PASSWORD=REPLACE_ME

# --- registry: ECR (set REGISTRY_TYPE=ecr) ---------------------------------------------------------------------
# AWS_ACCOUNT_ID=000000000000
# AWS_REGION=eu-central-1
# ECR_REPO_PREFIX=ai-scan

# --- app secrets (created only if absent; --rotate-secrets replaces all but ai-keys-master) ----------------------
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME
# GITHUB_WEBHOOK_SECRET=       # generated when empty
# INTERNAL_API_TOKEN=          # generated when empty (>= 32 chars)
# POSTGRES_PASSWORD=           # generated when empty
# AI_KEYS_ENCRYPTION_KEY=      # generated when ai-keys-master does not exist; never rotated by the installer
# AI_PROVIDER=none
# GRAFANA_ADMIN_PASSWORD=      # creates monitoring/grafana-admin when set
