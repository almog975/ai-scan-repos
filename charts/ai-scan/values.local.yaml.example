# Copy to values.local.yaml (gitignored) and use:
#   helm upgrade --install ai-scan ./charts/ai-scan -n ai-scan-repos --create-namespace -f charts/ai-scan/values.local.yaml
# GitHub OAuth App callback URL: http://localhost/auth/github/callback
secrets:
  githubClientId: <your-oauth-app-client-id>
  githubClientSecret: <your-oauth-app-client-secret>
  # aiApiKey: <optional>
# scanner:
#   aiProvider: openai
#   aiModel: gpt-4o-mini
