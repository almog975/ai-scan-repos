// CI/CD + GitOps on Docker Desktop (docs/cicd-docker-desktop.md). Jenkins job "ai-scan-cicd"
// (deploy/jenkins/local/values-local.yaml) polls GitHub every 2 min (no webhook reaches a laptop).
//   push to GitHub -> test changed services -> kaniko build (no Docker socket) -> trivy scan
//   -> push ghcr.io/almog975/ai-scan-repos-<svc>:<git sha> -> bot commits the tag into
//   charts/ai-scan/values-images.yaml [skip ci] -> Argo CD syncs the "ai-scan" release.
// Jenkins never runs helm/kubectl against the app: the agent pod's ServiceAccount has no RBAC.
// Credentials (create in Jenkins, never in git): ghcr-push, github-push (username + token).

def SERVICES = [ // svc : [source dir, values key in imageTags, image name]
  'frontend'  : ['frontend',   'frontend',  'ai-scan-repos-frontend'],
  'gateway'   : ['gateway',    'gateway',   'ai-scan-repos-gateway'],
  'review-api': ['review-api', 'reviewApi', 'ai-scan-repos-review-api'],
]
def REGISTRY  = 'ghcr.io/almog975'
def REPO      = 'github.com/almog975/ai-scan-repos.git'
def BOT_NAME  = 'ai-scan-ci-bot'
def BOT_EMAIL = 'ci-bot@ai-scan.local'
def VALUES    = 'charts/ai-scan/values-images.yaml'
def changed   = []
def skipBuild = false

def img = { String svc -> "${REGISTRY}/${SERVICES[svc][2]}:${env.GIT_SHA}" }
def tar = { String svc -> "${env.WORKSPACE}/.images/${svc}.tar" }

pipeline {
  agent { kubernetes { inheritFrom 'ai-scan-ci'; defaultContainer 'jnlp' } }
  parameters {
    booleanParam(name: 'BUILD_ALL', defaultValue: false, description: 'Build every service, not only the changed ones')
    string(name: 'TRIVY_SEVERITY', defaultValue: 'CRITICAL', description: 'Fail the build on these trivy severities (fixable only), e.g. CRITICAL,HIGH')
  }
  options { timestamps(); disableConcurrentBuilds(); buildDiscarder(logRotator(numToKeepStr: '30')) }
  stages {
    stage('Loop guard') { steps { script {
      def msg    = sh(script: 'git log -1 --pretty=%B', returnStdout: true).trim()
      def author = sh(script: 'git log -1 --pretty=%ae', returnStdout: true).trim()
      if (author == BOT_EMAIL || msg.contains('[skip ci]')) {
        skipBuild = true
        currentBuild.result = 'NOT_BUILT'
        currentBuild.description = 'CI bot / [skip ci] commit'
        echo "Last commit is from ${BOT_NAME} or has [skip ci]; nothing to do."
        return
      }
      env.GIT_SHA = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
      // The branch this build came from; the tag bump is pushed back to the same branch.
      env.TARGET_BRANCH = (env.GIT_BRANCH ?: 'origin/main').replaceFirst(/^origin\//, '')
      def base = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: 'HEAD~1'
      def haveBase = sh(script: "git cat-file -e '${base}^{commit}' 2>/dev/null && echo yes || echo no", returnStdout: true).trim() == 'yes'
      def files = haveBase ? sh(script: "git diff --name-only ${base} HEAD", returnStdout: true).trim().split('\n').findAll { it } : []
      changed = (params.BUILD_ALL || !haveBase) ? (SERVICES.keySet() as List)
              : (SERVICES.keySet().findAll { s -> files.any { it.startsWith("${SERVICES[s][0]}/") } } as List)
      echo "Branch ${env.TARGET_BRANCH}, sha ${env.GIT_SHA}, changed services: ${changed ?: 'none'}"
      if (!changed) { currentBuild.description = 'no service changed'; skipBuild = true; return }
      currentBuild.description = "${changed.join(', ')} @ ${env.GIT_SHA}"
      sh 'mkdir -p .images reports'
    } } }

    stage('Test') {
      when { expression { !skipBuild } }
      steps { script {
        changed.each { s ->
          if (s == 'frontend') {
            container('node') { dir('frontend') {
              sh 'npm ci --no-audit --no-fund'
              sh 'CI=true npx vitest run --reporter=default --reporter=junit --outputFile.junit=$WORKSPACE/reports/frontend-junit.xml'
              sh 'npm run build'
            } }
          } else {
            container('python') { dir(SERVICES[s][0]) {
              sh """python -m venv /tmp/venv-${s} && /tmp/venv-${s}/bin/pip install -q -r requirements.txt -r requirements-dev.txt
                    /tmp/venv-${s}/bin/python -m pytest -q -o addopts= -p no:cacheprovider --junitxml=\$WORKSPACE/reports/${s}-junit.xml tests"""
            } }
          }
        }
      } }
    }

    stage('Build (kaniko)') {
      when { expression { !skipBuild } }
      steps { script {
        changed.each { s ->
          container('kaniko') {
            sh """/kaniko/executor --context=dir://${env.WORKSPACE}/${SERVICES[s][0]} \
                  --dockerfile=${env.WORKSPACE}/${SERVICES[s][0]}/Dockerfile \
                  --build-arg=VITE_APP_VERSION=${env.GIT_SHA} \
                  --destination=${img(s)} --no-push --tar-path=${tar(s)} \
                  --cleanup --snapshot-mode=redo"""
          }
        }
      } }
    }

    stage('Scan (trivy)') {
      when { expression { !skipBuild } }
      steps { script {
        changed.each { s ->
          container('trivy') {
            sh "trivy image --input ${tar(s)} --exit-code 1 --ignore-unfixed --severity ${params.TRIVY_SEVERITY} --no-progress --cache-dir /tmp/trivy"
          }
        }
      } }
    }

    stage('Push (ghcr.io)') {
      when { expression { !skipBuild } }
      steps { script {
        changed.each { s ->
          container('crane') {
            withCredentials([usernamePassword(credentialsId: 'ghcr-push', usernameVariable: 'U', passwordVariable: 'P')]) {
              sh 'echo "$P" | crane auth login ghcr.io -u "$U" --password-stdin'
              sh "crane push ${tar(s)} ${img(s)}"
            }
          }
        }
      } }
    }

    stage('GitOps: bump values-images.yaml') {
      when { expression { !skipBuild } }
      steps { script {
        // Start from the branch tip (not the detached build commit) so only the tag lines change.
        sh "git fetch -q origin ${env.TARGET_BRANCH} && git checkout -q -B gitops-bump origin/${env.TARGET_BRANCH}"
        changed.each { s ->
          sh "sed -i -E 's|^(  ${SERVICES[s][1]}:).*|\\1 \"${env.GIT_SHA}\"|' ${VALUES}"
        }
        sh "git --no-pager diff -- ${VALUES}"
        if (!sh(script: "git status --porcelain -- ${VALUES}", returnStdout: true).trim()) {
          echo 'values-images.yaml already has these tags.'; return
        }
        sh "git add ${VALUES} && git -c user.name='${BOT_NAME}' -c user.email='${BOT_EMAIL}' commit -q -m 'ci(gitops): ${changed.join(',')} -> ${env.GIT_SHA} [skip ci]'"
        withCredentials([usernamePassword(credentialsId: 'github-push', usernameVariable: 'GU', passwordVariable: 'GT')]) {
          withEnv(["PUSH_URL=https://${REPO}", "BR=${env.TARGET_BRANCH}"]) {
            // The token only reaches git through a credential helper reading the masked env vars (never in a URL).
            sh '''set +x
              helper='!f() { echo "username=$GU"; echo "password=$GT"; }; f'
              for i in 1 2 3; do
                if git -c credential.helper= -c credential.helper="$helper" push "$PUSH_URL" "HEAD:refs/heads/$BR"; then exit 0; fi
                echo "push rejected (attempt $i); rebasing on $BR"
                git -c credential.helper= -c credential.helper="$helper" pull -q --rebase "$PUSH_URL" "$BR"
              done
              exit 1'''
          }
        }
        echo "Pushed. Argo CD (app ai-scan) picks it up within ~1 min."
      } }
    }
  }
  post {
    always { script { if (!skipBuild) { junit allowEmptyResults: true, testResults: 'reports/*-junit.xml' } } }
  }
}
