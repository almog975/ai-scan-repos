      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (state) (increase(reviews_total{namespace=\"ai-scan-repos\",state=~\"completed|failed|cancelled\"}[1h]))",
