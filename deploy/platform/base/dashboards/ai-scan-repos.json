        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(review_duration_seconds_bucket{namespace=\"ai-scan-repos\",state=\"completed\"}[1h])))",
