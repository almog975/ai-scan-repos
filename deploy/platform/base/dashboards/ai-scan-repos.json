{
  "uid": "ai-scan-repos",
  "title": "AI Scan Repos",
  "tags": [
    "ai-scan-repos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
